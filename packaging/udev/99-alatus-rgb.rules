# Alatus Hardware Orchestration Suite - ITE5570 LampArray HID Permissions
# Grants access to the alatus-rgb group for unprivileged LampArray feature report control
#
# Matches i2c-hid devices where parent i2c bus name identifies the controller:
SUBSYSTEM=="hidraw", KERNELS=="i2c-ITE5570*", MODE="0660", GROUP="alatus-rgb"

# VID/PID matches for controllers that expose USB descriptors:
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="19b6", MODE="0660", GROUP="alatus-rgb"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="5570", MODE="0660", GROUP="alatus-rgb"
