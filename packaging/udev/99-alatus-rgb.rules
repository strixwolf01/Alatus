# ASUS S5506MA / ITE5570 HID LampArray keyboard  (VRGB backend)
#
# Grants the `alatus-rgb` group unprivileged read/write access to the /dev/hidraw
# node behind the ITE5570 controller so Alatus can drive static RGB without
# sudo. Install automatically via Alatus's deb/rpm packaging.
#
# Matches the validated upstream vrgb rule (i2c-hid devices expose no
# idVendor/idProduct on the hidraw node; the parent i2c name is reliable):
SUBSYSTEM=="hidraw", KERNELS=="i2c-ITE5570*", MODE="0660", GROUP="alatus-rgb"

# VID/PID matches for controllers that do expose the USB descriptors:
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="19b6", MODE="0660", GROUP="alatus-rgb"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="5570", MODE="0660", GROUP="alatus-rgb"
