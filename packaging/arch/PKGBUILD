# Maintainer: StrixWolf <strixwolf@example.com>
pkgname=alatus-git
pkgver=2.0.0
pkgrel=1
pkgdesc="Linux hardware control suite for ASUS laptops written in Rust"
arch=('x86_64')
url="https://github.com/strixwolf01/Alatus"
license=('GPL-3.0-or-later')
depends=('dbus' 'polkit' 'systemd')
makedepends=('cargo' 'git')
provides=('alatus')
conflicts=('alatus')
source=('git+https://github.com/strixwolf01/Alatus.git')
sha256sums=('SKIP')

build() {
    cd "${srcdir}/Alatus"
    cargo build --release --locked
}

check() {
    cd "${srcdir}/Alatus"
    cargo test --workspace --locked
}

package() {
    cd "${srcdir}/Alatus"
    make DESTDIR="${pkgdir}" PREFIX="/usr" install
}
