import { DashboardTab } from "tabs/dashboard.slint";
import { BatteryTab } from "tabs/battery.slint";
import { CoolingTab } from "tabs/cooling.slint";
import { RgbTab } from "tabs/rgb.slint";
import { DisplayTab } from "tabs/display.slint";
import { GesturesTab } from "tabs/gestures.slint";
import { SystemTab } from "tabs/system.slint";
import { ScrollView } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Alatus - ASUS Hardware Control Suite";
    min-width: 900px;
    min-height: 640px;
    preferred-width: 960px;
    preferred-height: 680px;
    background: #1B1C20;
    default-font-family: "Noto Sans, Inter, system-ui, sans-serif";

    // Callbacks to Rust backend
    callback set_battery_limit(int);
    callback set_thermal_profile(string);
    callback set_lighting_brightness(int);
    callback set_lighting_color(int, int, int);
    callback set_lighting_mode(string, int);
    callback open_de_color_picker();
    callback set_display_refresh(int);
    callback set_oled_dimming(int);
    callback set_target_mode(bool);
    callback set_panel_autohide(bool);
    callback set_panel_transparency(bool);
    callback set_dpms_pixel_refresh(bool);
    callback set_kbd_idle_mode(string);
    callback set_kbd_idle_timeout(int);

    // State properties
    in-out property <int> active_tab: 0; // 0: Dashboard, 1: Battery, 2: Cooling, 3: Aura RGB, 4: Display, 5: Gestures, 6: System
    in-out property <bool> is_kde: true;
    in-out property <color> accent_color: #3B82F6;

    // Real DMI and hardware strings
    in-out property <string> device_model: "ASUS Vivobook S 15 OLED (S5506MA)";
    in-out property <string> board_name: "S5506MA";
    in-out property <string> bios_version: "S5506MA.318";
    in-out property <string> kernel_version: "Linux x86_64";
    in-out property <string> device_serial: "S3N0KD006297137";

    // Keyboard Backlight Idle Mode
    in-out property <string> kbd_idle_mode: "always_on";
    in-out property <int> kbd_idle_timeout_min: 1;

    // Display & Gesture properties
    in-out property <int> display_refresh_rate: 120;
    in-out property <int> oled_dimming_level: 100;
    in-out property <bool> target_mode_active: false;
    in-out property <bool> panel_autohide_active: false;
    in-out property <bool> panel_transparency_active: false;
    in-out property <bool> dpms_pixel_refresh_active: false;
    in-out property <string> display_output_name: "eDP-1";

    // Battery properties
    in-out property <int> battery_percentage: 0;
    in-out property <string> battery_status: "--";
    in-out property <int> battery_limit: 80;
    in-out property <int> battery_health: 100;
    in-out property <string> battery_power: "-- W";

    // Thermal properties
    in-out property <string> current_profile: "Balanced";
    in-out property <bool> full_speed_supported: true;
    in-out property <bool> is_cpu_only: false;
    in-out property <int> cpu_fan_rpm: 0;
    in-out property <int> gpu_fan_rpm: 0;
    in-out property <string> fan_cpu_only_text: " CPU : 0%/0% ";
    in-out property <string> fan_rpm_subtext: "";

    // Lighting properties
    in-out property <int> lighting_brightness: 3;
    in-out property <string> lighting_mode: "Static";
    in-out property <color> current_rgb_color: #00F0FF;
    in-out property <string> lighting_hex: "#00F0FF";
    in-out property <bool> has_multiple_modes: false;
    in-out property <bool> supports_mode_breathing: false;
    in-out property <bool> supports_mode_rainbow: false;
    in-out property <bool> supports_mode_strobe: false;

    HorizontalLayout {
        // ==========================================
        // LEFT SIDEBAR (KDE Breeze Style)
        // ==========================================
        Rectangle {
            width: 210px;
            background: #16171B;

            // 1px right border separating sidebar from content
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: 100%;
                background: #252830;
            }

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                // Brand Header: App Logo + Title + Status
                HorizontalLayout {
                    padding_left: 6px;
                    padding_right: 6px;
                    padding_top: 6px;
                    padding_bottom: 12px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "▲";
                            font-size: 18px;
                            font-weight: 900;
                            color: root.accent_color;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Alatus";
                            font-size: 15px;
                            font-weight: 700;
                            color: #FFFFFF;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: #00E676;
                        y: 8px;
                    }
                }

                Rectangle { height: 1px; background: #252830; }

                // Sidebar Navigation Items
                VerticalLayout {
                    spacing: 4px;
                    padding-top: 6px;

                    // Item 0: Dashboard (Home)
                    Rectangle {
                        height: 38px;
                        border-radius: 8px;
                        background: root.active_tab == 0 ? #2A2D35 : (item0_touch.has-hover ? #1F2128 : transparent);
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;
                            alignment: start;
                            Text { text: "🏠"; font-size: 13px; vertical-alignment: center; }
                            Text {
                                text: "Home";
                                font-size: 13px;
                                font-weight: root.active_tab == 0 ? 600 : 500;
                                color: root.active_tab == 0 ? #FFFFFF : #9CA3AF;
                                vertical-alignment: center;
                            }
                        }
                        item0_touch := TouchArea { mouse-cursor: pointer; clicked => { root.active_tab = 0; } }
                    }

                    // Item 1: Battery Care
                    Rectangle {
                        height: 38px;
                        border-radius: 8px;
                        background: root.active_tab == 1 ? #2A2D35 : (item1_touch.has-hover ? #1F2128 : transparent);
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;
                            alignment: start;
                            Text { text: "🔋"; font-size: 13px; vertical-alignment: center; }
                            Text {
                                text: "Battery";
                                font-size: 13px;
                                font-weight: root.active_tab == 1 ? 600 : 500;
                                color: root.active_tab == 1 ? #FFFFFF : #9CA3AF;
                                vertical-alignment: center;
                            }
                        }
                        item1_touch := TouchArea { mouse-cursor: pointer; clicked => { root.active_tab = 1; } }
                    }

                    // Item 2: Cooling & Thermal
                    Rectangle {
                        height: 38px;
                        border-radius: 8px;
                        background: root.active_tab == 2 ? #2A2D35 : (item2_touch.has-hover ? #1F2128 : transparent);
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;
                            alignment: start;
                            Text { text: "❄️"; font-size: 13px; vertical-alignment: center; }
                            Text {
                                text: "Cooling";
                                font-size: 13px;
                                font-weight: root.active_tab == 2 ? 600 : 500;
                                color: root.active_tab == 2 ? #FFFFFF : #9CA3AF;
                                vertical-alignment: center;
                            }
                        }
                        item2_touch := TouchArea { mouse-cursor: pointer; clicked => { root.active_tab = 2; } }
                    }

                    // Item 3: Aura RGB Keyboard Lighting
                    Rectangle {
                        height: 38px;
                        border-radius: 8px;
                        background: root.active_tab == 3 ? #2A2D35 : (item3_touch.has-hover ? #1F2128 : transparent);
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;
                            alignment: start;
                            Text { text: "💡"; font-size: 13px; vertical-alignment: center; }
                            Text {
                                text: "Aura RGB";
                                font-size: 13px;
                                font-weight: root.active_tab == 3 ? 600 : 500;
                                color: root.active_tab == 3 ? #FFFFFF : #9CA3AF;
                                vertical-alignment: center;
                            }
                        }
                        item3_touch := TouchArea { mouse-cursor: pointer; clicked => { root.active_tab = 3; } }
                    }

                    // Item 4: Display & OLED (KDE Plasma only)
                    if root.is_kde: Rectangle {
                        height: 38px;
                        border-radius: 8px;
                        background: root.active_tab == 4 ? #2A2D35 : (item4_touch.has-hover ? #1F2128 : transparent);
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;
                            alignment: start;
                            Text { text: "🖥️"; font-size: 13px; vertical-alignment: center; }
                            Text {
                                text: "Display";
                                font-size: 13px;
                                font-weight: root.active_tab == 4 ? 600 : 500;
                                color: root.active_tab == 4 ? #FFFFFF : #9CA3AF;
                                vertical-alignment: center;
                            }
                        }
                        item4_touch := TouchArea { mouse-cursor: pointer; clicked => { root.active_tab = 4; } }
                    }

                    // Item 5: Touchpad Gestures (KDE Plasma only)
                    if root.is_kde: Rectangle {
                        height: 38px;
                        border-radius: 8px;
                        background: root.active_tab == 5 ? #2A2D35 : (item5_touch.has-hover ? #1F2128 : transparent);
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;
                            alignment: start;
                            Text { text: "👆"; font-size: 13px; vertical-alignment: center; }
                            Text {
                                text: "Touchpad";
                                font-size: 13px;
                                font-weight: root.active_tab == 5 ? 600 : 500;
                                color: root.active_tab == 5 ? #FFFFFF : #9CA3AF;
                                vertical-alignment: center;
                            }
                        }
                        item5_touch := TouchArea { mouse-cursor: pointer; clicked => { root.active_tab = 5; } }
                    }

                    // Item 6: System Information
                    Rectangle {
                        height: 38px;
                        border-radius: 8px;
                        background: root.active_tab == 6 ? #2A2D35 : (item6_touch.has-hover ? #1F2128 : transparent);
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;
                            alignment: start;
                            Text { text: "⚙️"; font-size: 13px; vertical-alignment: center; }
                            Text {
                                text: "System";
                                font-size: 13px;
                                font-weight: root.active_tab == 6 ? 600 : 500;
                                color: root.active_tab == 6 ? #FFFFFF : #9CA3AF;
                                vertical-alignment: center;
                            }
                        }
                        item6_touch := TouchArea { mouse-cursor: pointer; clicked => { root.active_tab = 6; } }
                    }
                }

                // Spacer pushing footer to bottom
                Rectangle { }

                // Sidebar Footer (Brand info + version)
                Rectangle { height: 1px; background: #252830; }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    padding-top: 6px;
                    spacing: 8px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "⚡"; font-size: 11px; vertical-alignment: center; }
                        Text { text: "Alatus Suite"; font-size: 11px; color: #8C929E; vertical-alignment: center; }
                    }
                    Text { text: "v0.1.0"; font-size: 11px; color: #5A6070; vertical-alignment: center; }
                }
            }
        }

        // ==========================================
        // RIGHT MAIN CONTENT AREA
        // ==========================================
        VerticalLayout {
            // Header Bar with Centered Tab Name and Subtle Status
            Rectangle {
                height: 48px;
                background: #1B1C20;
                
                // Bottom divider
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: 100%;
                    background: #252830;
                }

                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    alignment: space-between;

                    // Left spacer
                    Rectangle { width: 100px; }

                    // Centered Current View Title
                    Text {
                        text: root.active_tab == 0 ? "Home" :
                              root.active_tab == 1 ? "Battery Care" :
                              root.active_tab == 2 ? "Cooling & Fans" :
                              root.active_tab == 3 ? "Aura RGB Lighting" :
                              root.active_tab == 4 ? "Display & OLED" :
                              root.active_tab == 5 ? "Touchpad Gestures" : "System Information";
                        font-size: 14px;
                        font-weight: 700;
                        color: #FFFFFF;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // Right Active Profile Badge
                    Rectangle {
                        width: 100px;
                        height: 24px;
                        y: 12px;
                        border-radius: 4px;
                        background: #23262F;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: root.current_profile == "FullSpeed" ? #FF0055 : root.accent_color;
                                y: 9px;
                            }
                            Text {
                                text: root.current_profile;
                                font-size: 11px;
                                font-weight: 700;
                                color: #FFFFFF;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Scrollable Tab View Content
            ScrollView {
                VerticalLayout {
                    padding: 24px;
                    alignment: start;

                    if root.active_tab == 0: DashboardTab {
                        battery_percentage: root.battery_percentage;
                        battery_status: root.battery_status;
                        battery_limit: root.battery_limit;
                        battery_health: root.battery_health;
                        battery_power: root.battery_power;
                        current_profile: root.current_profile;
                        full_speed_supported: root.full_speed_supported;
                        fan_cpu_only_text: root.fan_cpu_only_text;
                        fan_rpm_subtext: root.fan_rpm_subtext;
                        lighting_mode: root.lighting_mode;
                        current_rgb_color: root.current_rgb_color;
                        lighting_hex: root.lighting_hex;
                        lighting_brightness: root.lighting_brightness;
                        accent_color: root.accent_color;
                        device_model: root.device_model;
                        board_name: root.board_name;
                        bios_version: root.bios_version;
                        kernel_version: root.kernel_version;
                        device_serial: root.device_serial;
                        set_thermal_profile(p) => { root.set_thermal_profile(p); }
                        set_battery_limit(l) => { root.set_battery_limit(l); }
                    }

                    if root.active_tab == 1: BatteryTab {
                        battery_percentage: root.battery_percentage;
                        battery_status: root.battery_status;
                        battery_limit: root.battery_limit;
                        battery_health: root.battery_health;
                        battery_power: root.battery_power;
                        accent_color: root.accent_color;
                        set_battery_limit(l) => { root.set_battery_limit(l); }
                    }

                    if root.active_tab == 2: CoolingTab {
                        current_profile: root.current_profile;
                        full_speed_supported: root.full_speed_supported;
                        is_cpu_only: root.is_cpu_only;
                        cpu_fan_rpm: root.cpu_fan_rpm;
                        gpu_fan_rpm: root.gpu_fan_rpm;
                        fan_cpu_only_text: root.fan_cpu_only_text;
                        fan_rpm_subtext: root.fan_rpm_subtext;
                        accent_color: root.accent_color;
                        set_thermal_profile(p) => { root.set_thermal_profile(p); }
                    }

                    if root.active_tab == 3: RgbTab {
                        lighting_brightness: root.lighting_brightness;
                        lighting_mode: root.lighting_mode;
                        current_rgb_color: root.current_rgb_color;
                        lighting_hex: root.lighting_hex;
                        has_multiple_modes: root.has_multiple_modes;
                        supports_mode_breathing: root.supports_mode_breathing;
                        supports_mode_rainbow: root.supports_mode_rainbow;
                        supports_mode_strobe: root.supports_mode_strobe;
                        accent_color: root.accent_color;
                        kbd_idle_mode: root.kbd_idle_mode;
                        kbd_idle_timeout_min: root.kbd_idle_timeout_min;
                        set_lighting_brightness(b) => { root.set_lighting_brightness(b); }
                        set_lighting_mode(m, s) => { root.set_lighting_mode(m, s); }
                        set_lighting_color(r, g, b) => { root.set_lighting_color(r, g, b); }
                        open_de_color_picker => { root.open_de_color_picker(); }
                        set_kbd_idle_mode(m) => { root.set_kbd_idle_mode(m); }
                        set_kbd_idle_timeout(t) => { root.set_kbd_idle_timeout(t); }
                    }

                    if root.active_tab == 4 && root.is_kde: DisplayTab {
                        display_refresh_rate: root.display_refresh_rate;
                        oled_dimming_level: root.oled_dimming_level;
                        target_mode_active: root.target_mode_active;
                        panel_autohide_active: root.panel_autohide_active;
                        panel_transparency_active: root.panel_transparency_active;
                        dpms_pixel_refresh_active: root.dpms_pixel_refresh_active;
                        display_output_name: root.display_output_name;
                        accent_color: root.accent_color;
                        set_display_refresh(hz) => { root.set_display_refresh(hz); }
                        set_oled_dimming(val) => { root.set_oled_dimming(val); }
                        set_target_mode(en) => { root.set_target_mode(en); }
                        set_panel_autohide(en) => { root.set_panel_autohide(en); }
                        set_panel_transparency(en) => { root.set_panel_transparency(en); }
                        set_dpms_pixel_refresh(en) => { root.set_dpms_pixel_refresh(en); }
                    }

                    if root.active_tab == 5 && root.is_kde: GesturesTab {
                        accent_color: root.accent_color;
                    }

                    if root.active_tab == 6: SystemTab {
                        device_model: root.device_model;
                        board_name: root.board_name;
                        bios_version: root.bios_version;
                        kernel_version: root.kernel_version;
                        device_serial: root.device_serial;
                    }
                }
            }
        }
    }
}
