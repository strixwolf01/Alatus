import { GroupCard, SectionHeader } from "../components/card.slint";

export component CoolingTab inherits VerticalLayout {
    in property <string> current_profile: "Balanced";
    in property <bool> full_speed_supported: true;
    in property <bool> is_cpu_only: false;
    in property <int> cpu_fan_rpm: 0;
    in property <int> gpu_fan_rpm: 0;
    in property <string> fan_cpu_only_text: " CPU : 0%/0% ";
    in property <string> fan_rpm_subtext: "";
    in property <color> accent_color: #3B82F6;

    callback set_thermal_profile(string);

    spacing: 16px;
    alignment: start;

    GroupCard {
        VerticalLayout {
            padding: 20px;
            spacing: 16px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Thermal Performance Mode";
                    font-size: 16px;
                    font-weight: 700;
                    color: #FFFFFF;
                }
                Text {
                    text: "Active: " + root.current_profile;
                    font-size: 13px;
                    font-weight: 700;
                    color: root.current_profile == "FullSpeed" ? #FF0055 : root.accent_color;
                    vertical-alignment: center;
                }
            }

            Text {
                text: "Regulate ASUS hardware thermal power targets and fan curves:";
                font-size: 12px;
                color: #8C929E;
            }

            // 4 Profile Cards Row
            HorizontalLayout {
                spacing: 10px;

                // Whisper / Quiet
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 80px;
                    height: 70px;
                    border-radius: 8px;
                    background: root.current_profile == "Quiet" ? root.accent_color.with_alpha(0.2) : #23262E;
                    border-width: root.current_profile == "Quiet" ? 2px : 1px;
                    border-color: root.current_profile == "Quiet" ? root.accent_color : #2D3038;
                    TouchArea { clicked => { root.set_thermal_profile("Quiet"); } }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        padding-left: 4px;
                        padding-right: 4px;
                        Text {
                            text: "Whisper";
                            font-size: 14px;
                            font-weight: 700;
                            color: root.current_profile == "Quiet" ? root.accent_color : #FFFFFF;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Silent Fan Curve";
                            font-size: 10px;
                            color: #8C929E;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                // Standard / Balanced
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 80px;
                    height: 70px;
                    border-radius: 8px;
                    background: root.current_profile == "Balanced" ? root.accent_color.with_alpha(0.2) : #23262E;
                    border-width: root.current_profile == "Balanced" ? 2px : 1px;
                    border-color: root.current_profile == "Balanced" ? root.accent_color : #2D3038;
                    TouchArea { clicked => { root.set_thermal_profile("Balanced"); } }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        padding-left: 4px;
                        padding-right: 4px;
                        Text {
                            text: "Standard";
                            font-size: 14px;
                            font-weight: 700;
                            color: root.current_profile == "Balanced" ? root.accent_color : #FFFFFF;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Balanced Auto";
                            font-size: 10px;
                            color: #8C929E;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                // Performance
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 80px;
                    height: 70px;
                    border-radius: 8px;
                    background: root.current_profile == "Performance" ? root.accent_color.with_alpha(0.2) : #23262E;
                    border-width: root.current_profile == "Performance" ? 2px : 1px;
                    border-color: root.current_profile == "Performance" ? root.accent_color : #2D3038;
                    TouchArea { clicked => { root.set_thermal_profile("Performance"); } }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        padding-left: 4px;
                        padding-right: 4px;
                        Text {
                            text: "Performance";
                            font-size: 14px;
                            font-weight: 700;
                            color: root.current_profile == "Performance" ? root.accent_color : #FFFFFF;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Max Sustained";
                            font-size: 10px;
                            color: #8C929E;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                // Full Speed
                if root.full_speed_supported: Rectangle {
                    horizontal-stretch: 1;
                    min-width: 80px;
                    height: 70px;
                    border-radius: 8px;
                    background: root.current_profile == "FullSpeed" ? #FF005525 : #23262E;
                    border-width: root.current_profile == "FullSpeed" ? 2px : 1px;
                    border-color: root.current_profile == "FullSpeed" ? #FF0055 : #2D3038;
                    TouchArea { clicked => { root.set_thermal_profile("FullSpeed"); } }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        padding-left: 4px;
                        padding-right: 4px;
                        Text {
                            text: "⚡ Full Speed";
                            font-size: 14px;
                            font-weight: 800;
                            color: root.current_profile == "FullSpeed" ? #FF0055 : #FF6688;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "100% Fan Override";
                            font-size: 10px;
                            color: #8C929E;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // Fn+F Hardware Shortcut Description
            Rectangle {
                border-radius: 8px;
                background: #1C1E24;
                border-width: 1px;
                border-color: #2D3038;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 12px;

                    Rectangle {
                        width: 52px;
                        height: 28px;
                        border-radius: 6px;
                        background: root.accent_color.with_alpha(0.18);
                        border-width: 1px;
                        border-color: root.accent_color.with_alpha(0.5);

                        Text {
                            text: "Fn + F";
                            font-size: 11px;
                            font-weight: 700;
                            color: root.accent_color;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "Hardware Thermal Shortcut (Fn + F)";
                            font-size: 13px;
                            font-weight: 600;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Press Fn + F at any time to dynamically cycle through ASUS thermal modes: Whisper → Standard → Performance → Full Speed.";
                            font-size: 11px;
                            color: #8C929E;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}

