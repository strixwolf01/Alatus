import { SectionHeader, GroupCard } from "../components/card.slint";

export component DashboardTab inherits VerticalLayout {
    in property <int> battery_percentage: 0;
    in property <string> battery_status: "--";
    in property <int> battery_limit: 80;
    in property <int> battery_health: 100;
    in property <string> battery_power: "-- W";

    in property <string> current_profile: "Balanced";
    in property <bool> full_speed_supported: true;
    in property <string> fan_cpu_only_text: " CPU : 0%/0% ";
    in property <string> fan_rpm_subtext: "";

    in property <string> lighting_mode: "Static";
    in property <color> current_rgb_color: #00F0FF;
    in property <string> lighting_hex: "#00F0FF";
    in property <int> lighting_brightness: 3;
    in property <color> accent_color: #3B82F6;

    in property <string> device_model: "Laptop Device";
    in property <string> board_name: "Motherboard";
    in property <string> bios_version: "--";
    in property <string> kernel_version: "Linux";
    in property <string> device_serial: "[ Hidden ]";
    in property <bool> serial_revealed: false;
    in property <string> ram_usage_text: "0%";
    in property <string> ram_usage_detail: "-- / --";
    in property <string> screen_type: "OLED";
    in property <int> display_refresh_rate: 120;

    callback set_thermal_profile(string);
    callback set_battery_limit(int);
    callback reveal_serial();
    callback hide_serial();

    spacing: 18px;
    alignment: start;

    // Top: Laptop Header + Hardware Spec Details
    VerticalLayout {
        alignment: start;
        spacing: 12px;

        Text {
            text: root.device_model;
            font-size: 20px;
            font-weight: 800;
            color: #FFFFFF;
        }

        HorizontalLayout {
            spacing: 16px;

            // Left: Sleek Laptop Graphic with Active RGB Glow
            Rectangle {
                width: 290px;
                height: 175px;
                border-radius: 12px;
                background: #1B1D23;
                border-width: 1px;
                border-color: #2D3038;

                // Laptop Display Lid
                Rectangle {
                    width: 216px;
                    height: 124px;
                    border-radius: 6px;
                    background: #0E1014;
                    border-width: 2px;
                    border-color: #2D313C;
                    x: (parent.width - self.width) / 2;
                    y: 12px;

                    // Screen with Vibrant Gradient
                    Rectangle {
                        width: 206px;
                        height: 114px;
                        border-radius: 3px;
                        background: root.accent_color.with_alpha(0.3);
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;

                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: "ALATUS";
                                font-size: 14px;
                                font-weight: 900;
                                letter-spacing: 2px;
                                color: #FFFFFF;
                                horizontal-alignment: center;
                            }
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 20px;
                                    border-radius: 10px;
                                    background: #00000080;
                                    border-width: 1px;
                                    border-color: #FFFFFF28;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: center;
                                        Text {
                                            text: (root.display_refresh_rate > 0 ? root.display_refresh_rate + "Hz " : "120Hz ") + root.screen_type;
                                            font-size: 9px;
                                            font-weight: 700;
                                            color: #A0C0FF;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Laptop Aluminum Base Deck
                Rectangle {
                    width: 254px;
                    height: 18px;
                    border-radius: 4px;
                    background: #242730;
                    border-width: 1px;
                    border-color: #363A48;
                    x: (parent.width - self.width) / 2;
                    y: 138px;

                    // Keyboard RGB lighting underglow bar
                    Rectangle {
                        width: 180px;
                        height: 2px;
                        border-radius: 1px;
                        background: root.current_rgb_color;
                        x: 37px;
                        y: 3px;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: root.current_rgb_color;
                    }

                    // Touchpad indentation
                    Rectangle {
                        width: 56px;
                        height: 6px;
                        border-radius: 2px;
                        background: #171920;
                        x: 99px;
                        y: 8px;
                    }
                }
            }

            // Right: System Spec Details Card (Real hardware DMI data)
            GroupCard {
                VerticalLayout {
                    padding: 16px;
                    spacing: 11px;
                    alignment: space-between;

                    // Row: Mainboard
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Mainboard"; font-size: 12px; font-weight: 600; color: #8C929E; }
                        Text { text: "ASUSTeK " + root.board_name; font-size: 12px; font-weight: 600; color: #FFFFFF; }
                    }
                    Rectangle { height: 1px; background: #2D3038; }

                    // Row: BIOS
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "BIOS Firmware"; font-size: 12px; font-weight: 600; color: #8C929E; }
                        Text { text: root.bios_version; font-size: 12px; font-weight: 600; color: #FFFFFF; }
                    }
                    Rectangle { height: 1px; background: #2D3038; }

                    // Row: Kernel
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Kernel"; font-size: 12px; font-weight: 600; color: #8C929E; }
                        Text { text: root.kernel_version; font-size: 12px; font-weight: 600; color: #FFFFFF; }
                    }
                    Rectangle { height: 1px; background: #2D3038; }

                    // Row: Serial Number (Polkit-authenticated reveal)
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Serial Number"; font-size: 12px; font-weight: 600; color: #8C929E; vertical-alignment: center; }
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.serial_revealed ? root.device_serial : "[ Hidden ]";
                                font-size: 12px;
                                font-weight: 600;
                                color: root.serial_revealed ? #00F0FF : #8C929E;
                                vertical-alignment: center;
                            }
                            if !root.serial_revealed: Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: #23262E;
                                border-width: 1px;
                                border-color: #2D3038;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.reveal_serial(); }
                                }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: "Reveal";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: #FFFFFF;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            if root.serial_revealed: Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: #23262E;
                                border-width: 1px;
                                border-color: #2D3038;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.hide_serial(); }
                                }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: "Hide";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: #8C929E;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Middle: 4 Vital Metrics Cards in a Row
    HorizontalLayout {
        spacing: 12px;

        // Card 1: Battery
        GroupCard {
            VerticalLayout {
                padding: 14px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 6px;
                        background: #242832;
                        border-width: 1px;
                        border-color: #363B47;
                        Text { text: "🔋"; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "Battery"; font-size: 12px; font-weight: 600; color: #8C929E; vertical-alignment: center; }
                }
                Text {
                    text: root.battery_percentage + "%";
                    font-size: 22px;
                    font-weight: 800;
                    color: #FFFFFF;
                }
                Text {
                    text: root.battery_status + " (Limit " + root.battery_limit + "%)";
                    font-size: 10px;
                    color: #00E676;
                }
            }
        }

        // Card 2: CPU / Fan Telemetry
        GroupCard {
            VerticalLayout {
                padding: 14px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 6px;
                        background: #242832;
                        border-width: 1px;
                        border-color: #363B47;
                        Text { text: "❄️"; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "CPU Fans"; font-size: 12px; font-weight: 600; color: #8C929E; vertical-alignment: center; }
                }
                Text {
                    text: root.fan_cpu_only_text;
                    font-size: 18px;
                    font-weight: 800;
                    color: root.accent_color;
                }
                Text {
                    text: root.fan_rpm_subtext != "" ? root.fan_rpm_subtext : "Active";
                    font-size: 10px;
                    color: #8C929E;
                }
            }
        }

        // Card 3: System Memory (RAM)
        GroupCard {
            VerticalLayout {
                padding: 14px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 6px;
                        background: #242832;
                        border-width: 1px;
                        border-color: #363B47;
                        Text { text: "🧠"; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "RAM Usage"; font-size: 12px; font-weight: 600; color: #8C929E; vertical-alignment: center; }
                }
                Text {
                    text: root.ram_usage_text;
                    font-size: 20px;
                    font-weight: 800;
                    color: root.accent_color;
                }
                Text {
                    text: root.ram_usage_detail;
                    font-size: 10px;
                    color: #8C929E;
                }
            }
        }

        // Card 4: Power Draw & Health
        GroupCard {
            VerticalLayout {
                padding: 14px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 6px;
                        background: #242832;
                        border-width: 1px;
                        border-color: #363B47;
                        Text { text: "⚡"; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "Power & Health"; font-size: 12px; font-weight: 600; color: #8C929E; vertical-alignment: center; }
                }
                Text {
                    text: root.battery_power;
                    font-size: 20px;
                    font-weight: 800;
                    color: #FFFFFF;
                }
                Text {
                    text: "Battery Health: " + root.battery_health + "%";
                    font-size: 10px;
                    color: #8C929E;
                }
            }
        }
    }
}
