export component GesturesTab inherits VerticalLayout {
    spacing: 14px;

    // Overview Card
    Rectangle {
        border-radius: 12px;
        background: #141720;
        border-width: 1px;
        border-color: #242938;

        VerticalLayout {
            padding: 18px;
            spacing: 8px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Touchpad Edge Gestures";
                    font-size: 16px;
                    font-weight: 700;
                    color: #FFFFFF;
                }
                Rectangle {
                    height: 26px;
                    border-radius: 6px;
                    background: #122B22;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: "● ACTIVE (evdev kernel stream)";
                            font-size: 11px;
                            font-weight: 700;
                            color: #00E676;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Text {
                text: "Hardware-level edge touch gesture listener running in alatus-session. Operates on the outer 5% touchpad borders with built-in palm rejection.";
                font-size: 12px;
                color: #8A92A6;
            }
        }
    }

    // 3 Interactive Zone Cards
    HorizontalLayout {
        spacing: 12px;

        // Left Edge: Volume
        Rectangle {
            border-radius: 12px;
            background: #141720;
            border-width: 1px;
            border-color: #242938;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 8px;
                        background: #1B2B38;
                        Text { text: "🔊"; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Left Edge"; font-size: 14px; font-weight: 700; color: #FFFFFF; }
                        Text { text: "Audio Volume Control"; font-size: 11px; color: #00F0FF; }
                    }
                }

                Text {
                    text: "Swipe vertically up or down on the leftmost 5% of the touchpad to smoothly adjust system volume in 5% steps and unmute.";
                    font-size: 11px;
                    color: #8A92A6;
                }

                Rectangle {
                    height: 36px;
                    border-radius: 6px;
                    background: #11141D;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;
                        Text { text: "Action:"; font-size: 11px; color: #718096; vertical-alignment: center; }
                        Text { text: "pactl @DEFAULT_SINK@ ±5%"; font-size: 11px; font-weight: 600; color: #00E676; vertical-alignment: center; }
                    }
                }
            }
        }

        // Right Edge: Brightness
        Rectangle {
            border-radius: 12px;
            background: #141720;
            border-width: 1px;
            border-color: #242938;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 8px;
                        background: #2B2318;
                        Text { text: "☀️"; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Right Edge"; font-size: 14px; font-weight: 700; color: #FFFFFF; }
                        Text { text: "Screen Brightness"; font-size: 11px; color: #FFA000; }
                    }
                }

                Text {
                    text: "Swipe vertically up or down on the rightmost 5% of the touchpad to change screen brightness via KDE PowerDevil.";
                    font-size: 11px;
                    color: #8A92A6;
                }

                Rectangle {
                    height: 36px;
                    border-radius: 6px;
                    background: #11141D;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;
                        Text { text: "Action:"; font-size: 11px; color: #718096; vertical-alignment: center; }
                        Text { text: "KDE PowerDevil Brightness ±5%"; font-size: 11px; font-weight: 600; color: #FFA000; vertical-alignment: center; }
                    }
                }
            }
        }

        // Top Edge: Media Track Skip
        Rectangle {
            border-radius: 12px;
            background: #141720;
            border-width: 1px;
            border-color: #242938;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 8px;
                        background: #241A33;
                        Text { text: "⏯️"; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Top Edge"; font-size: 14px; font-weight: 700; color: #FFFFFF; }
                        Text { text: "Media Track Control"; font-size: 11px; color: #7C4DFF; }
                    }
                }

                Text {
                    text: "Swipe horizontally across the top 5% edge to trigger previous (swipe left) or next (swipe right) media track in active players.";
                    font-size: 11px;
                    color: #8A92A6;
                }

                Rectangle {
                    height: 36px;
                    border-radius: 6px;
                    background: #11141D;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;
                        Text { text: "Action:"; font-size: 11px; color: #718096; vertical-alignment: center; }
                        Text { text: "playerctl next / previous"; font-size: 11px; font-weight: 600; color: #7C4DFF; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
