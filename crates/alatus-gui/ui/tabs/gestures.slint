import { GroupCard, SectionHeader } from "../components/card.slint";

export component GesturesTab inherits VerticalLayout {
    in property <color> accent_color: #3B82F6;

    spacing: 16px;

    // Overview Card
    GroupCard {
        VerticalLayout {
            padding: 20px;
            spacing: 10px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Touchpad Edge Gestures";
                    font-size: 16px;
                    font-weight: 700;
                    color: #FFFFFF;
                }
                Rectangle {
                    height: 26px;
                    border-radius: 6px;
                    background: #00E67620;
                    border-width: 1px;
                    border-color: #00E67650;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: "● ACTIVE (evdev kernel stream)";
                            font-size: 11px;
                            font-weight: 700;
                            color: #00E676;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Text {
                text: "Hardware-level edge touch gesture listener running in alatus-session. Operates on the outer 5% touchpad borders with built-in palm rejection.";
                font-size: 12px;
                color: #8C929E;
                wrap: word-wrap;
            }
        }
    }

    // 3 Configured Edge Gesture Cards (Vertical Stack to fit any window width cleanly)
    VerticalLayout {
        spacing: 12px;

        // Card 1: Left Edge (Volume)
        GroupCard {
            HorizontalLayout {
                padding: 16px;
                spacing: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 8px;
                            background: #23262E;
                            border-width: 1px;
                            border-color: #2D3038;
                            Text { text: "🔊"; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Left Edge"; font-size: 14px; font-weight: 700; color: #FFFFFF; }
                            Text { text: "• Audio Volume"; font-size: 12px; font-weight: 600; color: #00F0FF; vertical-alignment: center; }
                        }
                        Text {
                            text: "Swipe vertically up or down on the leftmost 5% border to smoothly adjust system volume in 5% steps and unmute.";
                            font-size: 11px;
                            color: #8C929E;
                            wrap: word-wrap;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: #23262E;
                        border-width: 1px;
                        border-color: #2D3038;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            Text { text: "Action:"; font-size: 11px; color: #8C929E; vertical-alignment: center; }
                            Text { text: "pactl @DEFAULT_SINK@ ±5%"; font-size: 11px; font-weight: 700; color: #00E676; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        // Card 2: Right Edge (Brightness)
        GroupCard {
            HorizontalLayout {
                padding: 16px;
                spacing: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 8px;
                            background: #23262E;
                            border-width: 1px;
                            border-color: #2D3038;
                            Text { text: "☀️"; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Right Edge"; font-size: 14px; font-weight: 700; color: #FFFFFF; }
                            Text { text: "• Screen Brightness"; font-size: 12px; font-weight: 600; color: #FFA000; vertical-alignment: center; }
                        }
                        Text {
                            text: "Swipe vertically up or down on the rightmost 5% border to change OLED/LCD screen brightness via KDE PowerDevil.";
                            font-size: 11px;
                            color: #8C929E;
                            wrap: word-wrap;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: #23262E;
                        border-width: 1px;
                        border-color: #2D3038;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            Text { text: "Action:"; font-size: 11px; color: #8C929E; vertical-alignment: center; }
                            Text { text: "PowerDevil Brightness ±5%"; font-size: 11px; font-weight: 700; color: #FFA000; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        // Card 3: Top Edge (Media Track Skip)
        GroupCard {
            HorizontalLayout {
                padding: 16px;
                spacing: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 8px;
                            background: #23262E;
                            border-width: 1px;
                            border-color: #2D3038;
                            Text { text: "⏯️"; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Top Edge"; font-size: 14px; font-weight: 700; color: #FFFFFF; }
                            Text { text: "• Media Track Control"; font-size: 12px; font-weight: 600; color: #7C4DFF; vertical-alignment: center; }
                        }
                        Text {
                            text: "Swipe horizontally across the top 5% edge to trigger previous (swipe left) or next (swipe right) track in active media players.";
                            font-size: 11px;
                            color: #8C929E;
                            wrap: word-wrap;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: #23262E;
                        border-width: 1px;
                        border-color: #2D3038;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            Text { text: "Action:"; font-size: 11px; color: #8C929E; vertical-alignment: center; }
                            Text { text: "playerctl next / previous"; font-size: 11px; font-weight: 700; color: #7C4DFF; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
}
