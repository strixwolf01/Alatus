import { GroupCard, SectionHeader } from "../components/card.slint";
import { ToggleSwitch } from "../components/toggle.slint";

export component SystemTab inherits VerticalLayout {
    in property <string> device_model: "Laptop Device";
    in property <string> board_name: "Motherboard";
    in property <string> bios_version: "--";
    in property <string> kernel_version: "Linux";
    in property <string> device_serial: "[ Hidden ]";
    in property <bool> serial_revealed: false;
    in property <string> cpu_model: "Processor";
    in property <string> memory_total: "-- GB";
    in property <string> fan_driver_info: "ASUS ACPI / Platform Profile";

    in property <bool> stay_in_tray: true;
    in property <bool> start_on_boot: true;
    in property <color> accent_color: #3B82F6;

    callback toggle_stay_in_tray(bool);
    callback toggle_start_on_boot(bool);
    callback reveal_serial();

    spacing: 16px;
    alignment: start;

    // Card 1: Application Behavior & Session Preferences
    GroupCard {
        VerticalLayout {
            padding: 20px;
            spacing: 14px;

            SectionHeader {
                title: "Application Preferences";
                subtitle: "Configure background daemon, tray lifecycle, and startup behavior.";
            }

            // Toggle 1: Stay in tray
            Rectangle {
                height: 52px;
                border-radius: 8px;
                background: #23262E;
                border-width: 1px;
                border-color: #2D3038;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "Stay in System Tray";
                            font-size: 13px;
                            font-weight: 600;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Keep Alatus active in the system tray when the window is closed.";
                            font-size: 11px;
                            color: #8C929E;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        ToggleSwitch {
                            checked: root.stay_in_tray;
                            accent_color: root.accent_color;
                            toggled(val) => { root.toggle_stay_in_tray(val); }
                        }
                    }
                }
            }

            // Toggle 2: Start on startup
            Rectangle {
                height: 52px;
                border-radius: 8px;
                background: #23262E;
                border-width: 1px;
                border-color: #2D3038;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "Start on System Startup";
                            font-size: 13px;
                            font-weight: 600;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Launch the Alatus session agent and background hardware services on login.";
                            font-size: 11px;
                            color: #8C929E;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        ToggleSwitch {
                            checked: root.start_on_boot;
                            accent_color: root.accent_color;
                            toggled(val) => { root.toggle_start_on_boot(val); }
                        }
                    }
                }
            }
        }
    }
}

