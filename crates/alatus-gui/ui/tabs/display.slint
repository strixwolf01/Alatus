import { Slider } from "std-widgets.slint";
import { ToggleSwitch } from "../components/toggle.slint";
import { SectionHeader, GroupCard, NoticeText } from "../components/card.slint";

export component DisplayTab inherits VerticalLayout {
    in property <int> display_refresh_rate: 120;
    in property <int> oled_dimming_level: 100;
    in property <bool> target_mode_active: false;
    in property <bool> panel_autohide_active: false;
    in property <bool> panel_transparency_active: false;
    in property <bool> dpms_pixel_refresh_active: false;
    in property <string> display_output_name: "eDP-1";
    in property <color> accent_color: #3B82F6;
    in-out property <bool> auto_refresh_active: true;

    callback set_display_refresh(int);
    callback set_oled_dimming(int);
    callback set_target_mode(bool);
    callback set_panel_autohide(bool);
    callback set_panel_transparency(bool);
    callback set_dpms_pixel_refresh(bool);
    callback set_auto_refresh(bool);

    spacing: 16px;
    alignment: start;

    // Section 1: OLED Flicker-Free Dimming
    VerticalLayout {
        spacing: 6px;

        GroupCard {
            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                SectionHeader {
                    title: "OLED Flicker-Free Dimming";
                    subtitle: "Reduces OLED flickering at low brightness. For best results, set system brightness above 60% and use this slider to adjust perceived brightness.";
                }

                Rectangle { height: 1px; background: #2D3038; }

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Dimming Level";
                            font-size: 13px;
                            font-weight: 600;
                            color: #FFFFFF;
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: end;
                        Slider {
                            width: 220px;
                            minimum: 10;
                            maximum: 100;
                            value: root.oled_dimming_level;
                            changed(val) => {
                                root.set_oled_dimming(Math.round(val));
                            }
                        }
                        Text {
                            text: root.oled_dimming_level + "%";
                            font-size: 13px;
                            font-weight: 700;
                            color: #FFFFFF;
                            vertical-alignment: center;
                            min-width: 42px;
                            horizontal-alignment: right;
                        }
                    }
                }
            }
        }

        NoticeText {
            message: "* Image quality may be slightly affected when this feature is in use. This is normal and does not affect use of the display.";
        }
    }

    // Section 2: OLED Care
    VerticalLayout {
        spacing: 6px;

        GroupCard {
            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                SectionHeader {
                    title: "Alatus OLED Care";
                    subtitle: "Alatus OLED Care includes a set of optimization settings that's proven to protect your OLED display and maximize display lifespan.";
                }

                Rectangle { height: 1px; background: #2D3038; }

                // Row 1: Pixel Refresh
                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Pixel Refresh";
                            font-size: 13px;
                            font-weight: 600;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Launches a special screensaver after inactivity to evenly stress OLED pixels.";
                            font-size: 11px;
                            color: #8C929E;
                        }
                    }

                    ToggleSwitch {
                        checked: root.dpms_pixel_refresh_active;
                        accent_color: root.accent_color;
                        toggled(checked) => {
                            root.set_dpms_pixel_refresh(checked);
                        }
                    }
                }

                Rectangle { height: 1px; background: #2D3038; }

                // Row 2: Target Mode (Dim Inactive)
                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Target Mode (Dim Inactive)";
                            font-size: 13px;
                            font-weight: 600;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Dims inactive windows to reduce OLED burn-in and power consumption.";
                            font-size: 11px;
                            color: #8C929E;
                        }
                    }

                    ToggleSwitch {
                        checked: root.target_mode_active;
                        accent_color: root.accent_color;
                        toggled(checked) => {
                            root.set_target_mode(checked);
                        }
                    }
                }
            }
        }

        NoticeText {
            message: "Notice: Avoid displaying static images at maximum brightness for extended periods; otherwise, it might cause permanent burn-in damage to the OLED display.";
        }
    }

    // Section 4: Display Refresh Rate
    GroupCard {
        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            SectionHeader {
                title: "Display Refresh Rate (" + root.display_output_name + ")";
                subtitle: "Select the display refresh rate for smooth scrolling or battery preservation.";
            }

            Rectangle { height: 1px; background: #2D3038; }

            HorizontalLayout {
                spacing: 12px;

                // 60 Hz Pill
                Rectangle {
                    height: 40px;
                    border-radius: 8px;
                    background: root.display_refresh_rate == 60 ? root.accent_color.with_alpha(0.2) : #23262E;
                    border-width: root.display_refresh_rate == 60 ? 2px : 1px;
                    border-color: root.display_refresh_rate == 60 ? root.accent_color : #2D3038;
                    TouchArea { clicked => { root.set_display_refresh(60); } }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: "60 Hz";
                            font-size: 13px;
                            font-weight: 700;
                            color: root.display_refresh_rate == 60 ? root.accent_color : #FFFFFF;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "(Power Saving)";
                            font-size: 11px;
                            color: #8C929E;
                            vertical-alignment: center;
                        }
                    }
                }

                // 120 Hz Pill
                Rectangle {
                    height: 40px;
                    border-radius: 8px;
                    background: root.display_refresh_rate == 120 ? root.accent_color.with_alpha(0.2) : #23262E;
                    border-width: root.display_refresh_rate == 120 ? 2px : 1px;
                    border-color: root.display_refresh_rate == 120 ? root.accent_color : #2D3038;
                    TouchArea { clicked => { root.set_display_refresh(120); } }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: "120 Hz";
                            font-size: 13px;
                            font-weight: 700;
                            color: root.display_refresh_rate == 120 ? root.accent_color : #FFFFFF;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "(Smooth OLED)";
                            font-size: 11px;
                            color: #8C929E;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: #2D3038; }

            // Dynamic AC / Battery Auto Refresh Switcher
            Rectangle {
                height: 48px;
                border-radius: 8px;
                background: root.auto_refresh_active ? root.accent_color.with_alpha(0.12) : #23262E;
                border-width: root.auto_refresh_active ? 2px : 1px;
                border-color: root.auto_refresh_active ? root.accent_color : #2D3038;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 6px;
                                background: root.accent_color;
                                border-width: 1px;
                                border-color: #FFFFFF40;
                                Text { text: "⚡"; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Dynamic Auto Refresh Rate (AC / Battery)";
                                font-size: 13px;
                                font-weight: 600;
                                color: #FFFFFF;
                            }
                            Text {
                                text: "Automatically switch: 120Hz on charger (on ac) • 60Hz on battery (on bat).";
                                font-size: 11px;
                                color: #8C929E;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        ToggleSwitch {
                            checked: root.auto_refresh_active;
                            accent_color: root.accent_color;
                            toggled(val) => {
                                root.auto_refresh_active = val;
                                root.set_auto_refresh(val);
                            }
                        }
                    }
                }
            }
        }
    }
}
