import { Slider } from "std-widgets.slint";
import { ToggleSwitch } from "../components/toggle.slint";
import { SectionHeader, GroupCard, NoticeText } from "../components/card.slint";

export component DisplayTab inherits VerticalLayout {
    in property <int> display_refresh_rate: 120;
    in property <int> oled_dimming_level: 100;
    in property <bool> target_mode_active: false;
    in property <bool> panel_autohide_active: false;
    in property <bool> panel_transparency_active: false;
    in property <bool> dpms_pixel_refresh_active: false;
    in property <string> display_output_name: "eDP-1";
    in property <color> accent_color: #3B82F6;

    callback set_display_refresh(int);
    callback set_oled_dimming(int);
    callback set_target_mode(bool);
    callback set_panel_autohide(bool);
    callback set_panel_transparency(bool);
    callback set_dpms_pixel_refresh(bool);

    spacing: 16px;

    // Section 1: OLED Flicker-Free Dimming
    VerticalLayout {
        spacing: 6px;

        SectionHeader {
            title: "OLED Flicker-Free Dimming";
            subtitle: "Reduces OLED flickering at low brightness. For best results, set system brightness above 60% and use this slider to adjust perceived brightness.";
        }

        GroupCard {
            HorizontalLayout {
                padding: 14px;
                alignment: space-between;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Dimming Level";
                        font-size: 13px;
                        font-weight: 600;
                        color: #FFFFFF;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;
                    Slider {
                        width: 220px;
                        minimum: 10;
                        maximum: 100;
                        value: root.oled_dimming_level;
                        changed(val) => {
                            root.set_oled_dimming(Math.round(val));
                        }
                    }
                    Text {
                        text: root.oled_dimming_level + "%";
                        font-size: 13px;
                        font-weight: 700;
                        color: #FFFFFF;
                        vertical-alignment: center;
                        min-width: 42px;
                        horizontal-alignment: right;
                    }
                }
            }
        }

        NoticeText {
            message: "* Image quality may be slightly affected when this feature is in use. This is normal and does not affect use of the display.";
        }
    }

    // Section 2: Target Mode (Dim Inactive)
    VerticalLayout {
        spacing: 6px;

        SectionHeader {
            title: "Target Mode (Dim Inactive)";
            subtitle: "Dims inactive windows while the focused window stays at full brightness. Reduces OLED power consumption during focused work.";
        }

        GroupCard {
            HorizontalLayout {
                padding: 14px;
                alignment: space-between;
                VerticalLayout {
                    spacing: 3px;
                    Text {
                        text: "Enable Target Mode";
                        font-size: 13px;
                        font-weight: 600;
                        color: #FFFFFF;
                    }
                    Text {
                        text: "Activates the KWin Dim Inactive compositor effect.";
                        font-size: 11px;
                        color: #8C929E;
                    }
                }

                ToggleSwitch {
                    checked: root.target_mode_active;
                    accent_color: root.accent_color;
                    toggled(checked) => {
                        root.set_target_mode(checked);
                    }
                }
            }
        }
    }

    // Section 3: OLED Care
    VerticalLayout {
        spacing: 6px;

        SectionHeader {
            title: "Alatus OLED Care";
            subtitle: "Alatus OLED Care includes a set of optimization settings that's proven to protect your OLED display and maximize display lifespan.";
        }

        GroupCard {
            VerticalLayout {
                padding: 14px;
                spacing: 12px;

                // Row 1: Pixel Refresh
                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Pixel Refresh";
                            font-size: 13px;
                            font-weight: 600;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Launches a special screensaver after inactivity to evenly stress OLED pixels.";
                            font-size: 11px;
                            color: #8C929E;
                        }
                    }

                    ToggleSwitch {
                        checked: root.dpms_pixel_refresh_active;
                        accent_color: root.accent_color;
                        toggled(checked) => {
                            root.set_dpms_pixel_refresh(checked);
                        }
                    }
                }

                Rectangle { height: 1px; background: #2D3038; }

                // Row 2: Auto-hide KDE Panel
                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Auto-hide KDE Panel";
                            font-size: 13px;
                            font-weight: 600;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Automatically hides the KDE panel to reduce static elements on the OLED display.";
                            font-size: 11px;
                            color: #8C929E;
                        }
                    }

                    ToggleSwitch {
                        checked: root.panel_autohide_active;
                        accent_color: root.accent_color;
                        toggled(checked) => {
                            root.set_panel_autohide(checked);
                        }
                    }
                }

                Rectangle { height: 1px; background: #2D3038; }

                // Row 3: Panel Transparency Effect
                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Panel Transparency Effect";
                            font-size: 13px;
                            font-weight: 600;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Enables KDE panel transparency to reduce OLED burn-in.";
                            font-size: 11px;
                            color: #8C929E;
                        }
                    }

                    ToggleSwitch {
                        checked: root.panel_transparency_active;
                        accent_color: root.accent_color;
                        toggled(checked) => {
                            root.set_panel_transparency(checked);
                        }
                    }
                }
            }
        }

        NoticeText {
            message: "Notice: Avoid displaying static images at maximum brightness for extended periods; otherwise, it might cause permanent burn-in damage to the OLED display.";
        }
    }

    // Section 4: Display Refresh Rate
    VerticalLayout {
        spacing: 6px;

        SectionHeader {
            title: "Display Refresh Rate (" + root.display_output_name + ")";
            subtitle: "Select the display refresh rate for smooth scrolling or battery preservation.";
        }

        GroupCard {
            HorizontalLayout {
                padding: 12px;
                spacing: 12px;

                // 60 Hz Pill
                Rectangle {
                    height: 40px;
                    border-radius: 8px;
                    background: root.display_refresh_rate == 60 ? root.accent_color.with_alpha(0.2) : #1B1D23;
                    border-width: root.display_refresh_rate == 60 ? 2px : 1px;
                    border-color: root.display_refresh_rate == 60 ? root.accent_color : #2D3038;
                    TouchArea { clicked => { root.set_display_refresh(60); } }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: "60 Hz";
                            font-size: 13px;
                            font-weight: 700;
                            color: root.display_refresh_rate == 60 ? root.accent_color : #FFFFFF;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "(Power Saving)";
                            font-size: 11px;
                            color: #8C929E;
                            vertical-alignment: center;
                        }
                    }
                }

                // 120 Hz Pill
                Rectangle {
                    height: 40px;
                    border-radius: 8px;
                    background: root.display_refresh_rate == 120 ? root.accent_color.with_alpha(0.2) : #1B1D23;
                    border-width: root.display_refresh_rate == 120 ? 2px : 1px;
                    border-color: root.display_refresh_rate == 120 ? root.accent_color : #2D3038;
                    TouchArea { clicked => { root.set_display_refresh(120); } }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: "120 Hz";
                            font-size: 13px;
                            font-weight: 700;
                            color: root.display_refresh_rate == 120 ? root.accent_color : #FFFFFF;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "(Smooth OLED)";
                            font-size: 11px;
                            color: #8C929E;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
