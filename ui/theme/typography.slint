export global Typography {
    out property <length> h1: 18px;
    out property <length> h2: 16px;
    out property <length> h3: 14px;
    out property <length> body: 13px;
    out property <length> body_sm: 12px;
    out property <length> caption: 11px;
    out property <length> micro: 10px;
}

