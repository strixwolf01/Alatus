export global Palette {
    // Surface & background tones
    out property <color> background: #0f1015;
    out property <color> sidebar_bg: #141218;
    out property <color> card_bg: #211f26;
    out property <color> card_hover: #2b2930;
    out property <color> surface_variant: #2b2930;
    out property <color> surface_container: #18171d;
    out property <color> separator: #2b2930;

    // Text & content tones
    out property <color> text_primary: #f1f5f9;
    out property <color> text_secondary: #94a3b8;
    out property <color> text_muted: #64748b;
    out property <color> text_disabled: #475569;

    // Status & Accent
    out property <color> status_active: #a6e3a1;
    out property <color> status_error: #f2b8b5;
    out property <color> warning_bg: #2a2015;
    out property <color> warning_text: #fab387;
    out property <color> warning_desc: #e2cca8;

    // Default Material 3 Accents
    out property <color> default_accent: #d0bcff;
    out property <color> default_accent_container: #4f378b;
    out property <color> default_on_accent_container: #eaddff;
    out property <color> default_on_accent: #381e72;
}

