import { ScrollView } from "std-widgets.slint";

// Theme & Models
import { Theme, Palette, Typography } from "theme/theme.slint";
import { MetricItem, DiagItem, RgbPreset } from "models/types.slint";

// Components used in coordinator shell
import { HomeIcon, DisplayIcon, KeyboardIcon, SystemIcon, InfoIcon } from "components/icons.slint";
import { NavItem } from "components/controls.slint";

// Views
import { OverviewView } from "views/overview_view.slint";
import { DisplayView } from "views/display_view.slint";
import { RgbView } from "views/rgb_view.slint";
import { ThermalView } from "views/thermal_view.slint";
import { BatteryView } from "views/battery_view.slint";
import { DiagnosticsView } from "views/diagnostics_view.slint";

export {
    Theme, Palette, Typography,
    MetricItem, DiagItem, RgbPreset
}

// -------------------------------------------------------------
// Main Application Window Coordinator Shell
// -------------------------------------------------------------

export component AppWindow inherits Window {
    title: "Alatus - ASUS Hardware Control Center";
    icon: @image-url("../packaging/io.strixwolf.alatus.svg");
    min-width: 840px;
    min-height: 560px;
    preferred-width: 920px;
    preferred-height: 620px;
    background: #0f1015;

    // Dynamic Material 3 System Accent Palette
    in-out property <color> accent_color: #d0bcff;
    in-out property <color> accent_container: #4f378b;
    in-out property <color> on_accent_container: #eaddff;
    in-out property <color> on_accent: #381e72;

    // Navigation & View State
    in-out property <int> current_tab: 0; // 0=Home, 1=Display, 2=RGB, 3=System, 4=System Info
    in-out property <int> thermal_mode: 1; // 0=Quiet, 1=Balanced, 2=Perf, 3=Full
    in-out property <bool> oled_care_enabled: true;
    in-out property <string> oled_screen_hours: "0.0";
    in-out property <int> oled_refresh_count: 0;
    in-out property <int> oled_dim_level: 100; // 10% to 100% Flicker-Free Dimming
    in-out property <int> selected_refresh_rate: 120; // 60, 120, or 0 (Auto)
    in-out property <int> rgb_brightness: 80;
    in-out property <int> rgb_timeout: 60; // Delay in seconds: 10, 30, 60, 120, 300
    in-out property <int> rgb_timeout_policy: 2; // 0=Never, 1=BatteryOnly, 2=Always
    in-out property <int> selected_rgb_preset: 0; // 0=Auto-Sync, 1=Cyan, 2=Purple, 3=White, 4=Amber, -1=Custom
    in-out property <int> custom_red: 255;
    in-out property <int> custom_green: 128;
    in-out property <int> custom_blue: 0;
    in-out property <int> charge_limit: 80; // 50% to 100%
    in-out property <string> cpu_temp: "--°C";
    in-out property <string> fan_rpm: "-- RPM";
    in-out property <string> power_source: "AC";
    in-out property <string> active_connector: "eDP-1";
    in-out property <string> refresh_rate: "120.0 Hz";
    in-out property <string> session_daemon_status: "Active";
    in-out property <string> root_daemon_status: "Active";
    in-out property <string> refresh_status_text: "";
    in-out property <string> version_text: "v2.0.0";

    // Tri-State Subsystem Hardware Capabilities ("supported", "unavailable", "unsupported")
    in-out property <string> rgb_capability: "supported";
    in-out property <string> rgb_unavailable_reason: "";
    in-out property <string> thermal_capability: "supported";
    in-out property <string> thermal_unavailable_reason: "";
    in-out property <string> battery_capability: "supported";
    in-out property <string> battery_unavailable_reason: "";
    in-out property <string> display_capability: "supported";
    in-out property <string> display_unavailable_reason: "";

    // Application Preferences & Tray Integration
    in-out property <bool> tray_enabled: true;
    in-out property <bool> autostart_enabled: false;

    // Hardware Specs & Serial Reveal
    in-out property <string> hw_model: "Hardware Device";
    in-out property <string> hw_bios: "BIOS: --";
    in-out property <string> hw_kernel: "Kernel: --";
    in-out property <string> hw_compositor: "Compositor: --";
    in-out property <string> hw_battery_id: "Battery: --";
    in-out property <string> hw_bios_kernel: "BIOS: -- | Kernel: --";
    in-out property <string> hw_serial: "••••••••••••";
    in-out property <bool> hw_serial_revealed: false;
    in-out property <string> hw_copy_status: "";

    // Exhaustive System Specifications
    in-out property <string> hw_cpu: "--";
    in-out property <string> hw_ram: "--";
    in-out property <string> hw_motherboard: "--";
    in-out property <string> hw_bios_detailed: "--";
    in-out property <string> hw_gpu: "--";

    // Dedicated Battery Health & Telemetry
    in-out property <string> hw_battery_status: "--";
    in-out property <string> hw_battery_pct: "--%";
    in-out property <string> hw_battery_health: "--%";
    in-out property <string> hw_battery_cycles: "--";
    in-out property <string> hw_battery_manufacturer: "--";

    // Hardware Compatibility Test Suite Diagnostics
    in-out property <string> diag_wmi_status: "Checking...";
    in-out property <string> diag_wmi_desc: "Platform Thermal Profile Interface";
    in-out property <string> diag_rgb_status: "Checking...";
    in-out property <string> diag_rgb_desc: "Hardware Backlight Controller";
    in-out property <string> diag_oled_status: "Checking...";
    in-out property <string> diag_oled_desc: "Compositor Flicker-Free Dimming";
    in-out property <string> diag_hotkey_status: "Checking...";
    in-out property <string> diag_hotkey_desc: "Platform Thermal Policy Hotkey (evdev / code 482)";
    in-out property <string> diag_charge_status: "Checking...";
    in-out property <string> diag_charge_desc: "Battery Hardware Charge Threshold (charge_control_end_threshold)";
    in-out property <bool> is_diagnosing: false;

    // Callbacks
    callback set_thermal_mode(int);
    callback toggle_oled_care(bool);
    callback trigger_pixel_refresh();
    callback set_oled_dim_level(int);
    callback set_refresh_rate(int);
    callback set_rgb_brightness(int);
    callback set_rgb_timeout(int);
    callback set_rgb_timeout_policy(int);
    callback set_rgb_preset(int);
    callback apply_custom_rgb(int, int, int);
    callback set_charge_limit(int);
    callback reveal_serial();
    callback copy_serial();
    callback run_diagnostics();
    callback toggle_tray(bool);
    callback toggle_autostart(bool);

    HorizontalLayout {
        // -------------------------------------------------------------
        // LEFT SIDEBAR (Width: 220px, Background: #141218)
        // -------------------------------------------------------------
        Rectangle {
            width: 220px;
            background: #141218;

            // Right border separator
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: 100%;
                background: #2b2930;
            }

            VerticalLayout {
                padding-top: 24px;
                padding-bottom: 20px;
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                // Brand Header
                VerticalLayout {
                    spacing: 4px;
                    padding-left: 6px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: root.accent_color;
                            y: 4px;
                        }
                        Text {
                            text: "ALATUS";
                            color: #f1f5f9;
                            font-size: 15px;
                            font-weight: 800;
                            letter-spacing: 1.5px;
                        }
                    }

                    Text {
                        text: "ASUS Hardware Control Center";
                        color: #64748b;
                        font-size: 11px;
                    }
                }

                // Navigation Tabs
                VerticalLayout {
                    spacing: 6px;
                    alignment: start;

                    NavItem {
                        label: "Home";
                        selected: root.current_tab == 0;
                        accent_container: root.accent_container;
                        on_accent_container: root.on_accent_container;
                        clicked => { root.current_tab = 0; }
                        HomeIcon {
                            icon_color: root.current_tab == 0 ? root.on_accent_container : #94a3b8;
                        }
                    }
                    NavItem {
                        label: "Display";
                        selected: root.current_tab == 1;
                        accent_container: root.accent_container;
                        on_accent_container: root.on_accent_container;
                        clicked => { root.current_tab = 1; }
                        DisplayIcon {
                            icon_color: root.current_tab == 1 ? root.on_accent_container : #94a3b8;
                        }
                    }
                    NavItem {
                        label: "Keyboard & RGB";
                        selected: root.current_tab == 2;
                        accent_container: root.accent_container;
                        on_accent_container: root.on_accent_container;
                        clicked => { root.current_tab = 2; }
                        KeyboardIcon {
                            icon_color: root.current_tab == 2 ? root.on_accent_container : #94a3b8;
                        }
                    }
                    NavItem {
                        label: "System & Thermal";
                        selected: root.current_tab == 3;
                        accent_container: root.accent_container;
                        on_accent_container: root.on_accent_container;
                        clicked => { root.current_tab = 3; }
                        SystemIcon {
                            icon_color: root.current_tab == 3 ? root.on_accent_container : #94a3b8;
                        }
                    }
                    NavItem {
                        label: "System Info";
                        selected: root.current_tab == 4;
                        accent_container: root.accent_container;
                        on_accent_container: root.on_accent_container;
                        clicked => { root.current_tab = 4; }
                        InfoIcon {
                            icon_color: root.current_tab == 4 ? root.on_accent_container : #94a3b8;
                        }
                    }
                }

                // Footer Statuses
                VerticalLayout {
                    spacing: 6px;
                    padding-left: 6px;
                    padding-right: 6px;

                    Rectangle {
                        height: 1px;
                        background: #2b2930;
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Daemon";
                            color: #64748b;
                            font-size: 11px;
                        }
                        Text {
                            text: root.root_daemon_status;
                            color: root.root_daemon_status == "Active" ? #a6e3a1 : #f2b8b5;
                            font-size: 11px;
                            font-weight: 600;
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Session";
                            color: #64748b;
                            font-size: 11px;
                        }
                        Text {
                            text: root.session_daemon_status;
                            color: root.session_daemon_status == "Active" ? #a6e3a1 : #f2b8b5;
                            font-size: 11px;
                            font-weight: 600;
                        }
                    }

                    Text {
                        text: "Alatus " + root.version_text;
                        color: #475569;
                        font-size: 10px;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // -------------------------------------------------------------
        // RIGHT CONTENT AREA (Background: #0f1015, Padding: 20px)
        // -------------------------------------------------------------
        Rectangle {
            horizontal-stretch: 1;
            background: #0f1015;

            ScrollView {
                width: 100%;
                height: 100%;
                content-width: self.width;

                VerticalLayout {
                    horizontal-stretch: 1;
                    padding-left: 20px;
                    padding-right: 32px;
                    padding-top: 20px;
                    padding-bottom: 24px;
                    spacing: 16px;
                    alignment: start;

                    // PAGE 0: HOME / OVERVIEW
                    if root.current_tab == 0: OverviewView {
                        power_source: root.power_source;
                        hw_model: root.hw_model;
                        hw_bios: root.hw_bios;
                        cpu_temp: root.cpu_temp;
                        fan_rpm: root.fan_rpm;
                        thermal_mode: root.thermal_mode;
                        oled_screen_hours: root.oled_screen_hours;
                        accent_color: root.accent_color;
                        accent_container: root.accent_container;
                        on_accent_container: root.on_accent_container;
                        thermal_capability: root.thermal_capability;
                        thermal_unavailable_reason: root.thermal_unavailable_reason;
                        set_thermal_mode(val) => {
                            root.thermal_mode = val;
                            root.set_thermal_mode(val);
                        }
                    }

                    // PAGE 1: DISPLAY
                    if root.current_tab == 1: DisplayView {
                        display_capability: root.display_capability;
                        display_unavailable_reason: root.display_unavailable_reason;
                        oled_screen_hours: root.oled_screen_hours;
                        oled_refresh_count: root.oled_refresh_count;
                        refresh_status_text: root.refresh_status_text;
                        oled_dim_level: root.oled_dim_level;
                        active_connector: root.active_connector;
                        refresh_rate: root.refresh_rate;
                        selected_refresh_rate: root.selected_refresh_rate;
                        accent_color: root.accent_color;
                        accent_container: root.accent_container;
                        on_accent_container: root.on_accent_container;
                        on_accent: root.on_accent;
                        trigger_pixel_refresh => { root.trigger_pixel_refresh(); }
                        set_oled_dim_level(val) => {
                            root.oled_dim_level = val;
                            root.set_oled_dim_level(val);
                        }
                        set_refresh_rate(val) => {
                            root.selected_refresh_rate = val;
                            root.set_refresh_rate(val);
                        }
                    }

                    // PAGE 2: KEYBOARD & RGB
                    if root.current_tab == 2: RgbView {
                        rgb_capability: root.rgb_capability;
                        rgb_unavailable_reason: root.rgb_unavailable_reason;
                        rgb_brightness: root.rgb_brightness;
                        selected_rgb_preset: root.selected_rgb_preset;
                        rgb_timeout: root.rgb_timeout;
                        rgb_timeout_policy: root.rgb_timeout_policy;
                        custom_red <=> root.custom_red;
                        custom_green <=> root.custom_green;
                        custom_blue <=> root.custom_blue;
                        accent_color: root.accent_color;
                        accent_container: root.accent_container;
                        on_accent_container: root.on_accent_container;
                        on_accent: root.on_accent;
                        set_rgb_brightness(val) => {
                            root.rgb_brightness = val;
                            root.set_rgb_brightness(val);
                        }
                        set_rgb_preset(val) => {
                            root.selected_rgb_preset = val;
                            root.set_rgb_preset(val);
                        }
                        set_rgb_timeout(val) => {
                            root.rgb_timeout = val;
                            root.set_rgb_timeout(val);
                        }
                        set_rgb_timeout_policy(val) => {
                            root.rgb_timeout_policy = val;
                            root.set_rgb_timeout_policy(val);
                        }
                        apply_custom_rgb(r, g, b) => {
                            root.selected_rgb_preset = -1;
                            root.apply_custom_rgb(r, g, b);
                        }
                    }

                    // PAGE 3: SYSTEM & THERMAL
                    if root.current_tab == 3: VerticalLayout {
                        spacing: 14px;

                        ThermalView {
                            thermal_capability: root.thermal_capability;
                            thermal_unavailable_reason: root.thermal_unavailable_reason;
                            thermal_mode: root.thermal_mode;
                            accent_color: root.accent_color;
                            accent_container: root.accent_container;
                            on_accent_container: root.on_accent_container;
                            set_thermal_mode(val) => {
                                root.thermal_mode = val;
                                root.set_thermal_mode(val);
                            }
                        }

                        BatteryView {
                            battery_capability: root.battery_capability;
                            battery_unavailable_reason: root.battery_unavailable_reason;
                            charge_limit: root.charge_limit;
                            accent_color: root.accent_color;
                            accent_container: root.accent_container;
                            on_accent_container: root.on_accent_container;
                            set_charge_limit(val) => {
                                root.charge_limit = val;
                                root.set_charge_limit(val);
                            }
                        }
                    }

                    // PAGE 4: SYSTEM INFO & HARDWARE DIAGNOSTICS
                    if root.current_tab == 4: DiagnosticsView {
                        hw_model: root.hw_model;
                        hw_motherboard: root.hw_motherboard;
                        hw_cpu: root.hw_cpu;
                        hw_ram: root.hw_ram;
                        hw_gpu: root.hw_gpu;
                        hw_bios_detailed: root.hw_bios_detailed;
                        hw_kernel: root.hw_kernel;
                        hw_compositor: root.hw_compositor;
                        hw_serial: root.hw_serial;
                        hw_serial_revealed: root.hw_serial_revealed;
                        hw_copy_status: root.hw_copy_status;
                        hw_battery_status: root.hw_battery_status;
                        hw_battery_pct: root.hw_battery_pct;
                        hw_battery_health: root.hw_battery_health;
                        hw_battery_cycles: root.hw_battery_cycles;
                        hw_battery_id: root.hw_battery_id;
                        hw_battery_manufacturer: root.hw_battery_manufacturer;
                        is_diagnosing: root.is_diagnosing;
                        diag_wmi_status: root.diag_wmi_status;
                        diag_wmi_desc: root.diag_wmi_desc;
                        diag_rgb_status: root.diag_rgb_status;
                        diag_rgb_desc: root.diag_rgb_desc;
                        diag_oled_status: root.diag_oled_status;
                        diag_oled_desc: root.diag_oled_desc;
                        diag_hotkey_status: root.diag_hotkey_status;
                        diag_hotkey_desc: root.diag_hotkey_desc;
                        diag_charge_status: root.diag_charge_status;
                        diag_charge_desc: root.diag_charge_desc;
                        tray_enabled <=> root.tray_enabled;
                        autostart_enabled <=> root.autostart_enabled;
                        accent_color: root.accent_color;
                        accent_container: root.accent_container;
                        on_accent_container: root.on_accent_container;
                        reveal_serial => { root.reveal_serial(); }
                        copy_serial => { root.copy_serial(); }
                        run_diagnostics => { root.run_diagnostics(); }
                        toggle_tray(val) => { root.toggle_tray(val); }
                        toggle_autostart(val) => { root.toggle_autostart(val); }
                    }
                }
            }
        }
    }
}
