import { ScrollView } from "std-widgets.slint";

// -------------------------------------------------------------
// Material Design 3 Basic Components
// -------------------------------------------------------------

component M3Card inherits Rectangle {
    background: #211f26;
    border-radius: 14px;
    clip: true;
    horizontal-stretch: 1;
    min-width: 0px;
}

component M3Badge inherits Rectangle {
    in property <string> text;
    in property <color> badge_color: #4a4458;
    in property <color> text_color: #e8def8;
    background: badge_color;
    border-radius: 6px;
    height: 24px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            @children
        }

        Text {
            text: root.text;
            color: root.text_color;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

